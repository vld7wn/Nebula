rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: проверка авторизации
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: проверка владельца
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // ==================== Users ====================
    match /users/{userId} {
      // Читать профиль может любой авторизованный
      allow read: if isAuthenticated();
      
      // Изменять только свой профиль
      allow write: if isOwner(userId);
    }
    
    // ==================== Chats ====================
    match /chats/{chatId} {
      // Читать и писать могут только участники чата
      allow read, write: if isAuthenticated() 
        && request.auth.uid in resource.data.participants;
      
      // Создание чата - авторизованный пользователь должен быть участником
      allow create: if isAuthenticated() 
        && request.auth.uid in request.resource.data.participants;
      
      // ==================== Messages ====================
      match /messages/{messageId} {
        // Читать сообщения могут участники родительского чата
        allow read: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        // Писать сообщения могут участники чата
        allow create: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        
        // Редактировать только свои сообщения
        allow update: if isAuthenticated() 
          && resource.data.senderId == request.auth.uid;
        
        // Удалять только свои сообщения
        allow delete: if isAuthenticated() 
          && resource.data.senderId == request.auth.uid;
      }
    }
    
    // ==================== Time Capsules ====================
    match /time_capsules/{capsuleId} {
      // Читать могут отправитель и получатель
      allow read: if isAuthenticated() 
        && request.auth.uid in resource.data.participants;
      
      // Создавать может авторизованный пользователь
      allow create: if isAuthenticated() 
        && request.resource.data.senderId == request.auth.uid;
      
      // Обновлять может только отправитель (до открытия)
      allow update: if isAuthenticated() 
        && resource.data.senderId == request.auth.uid
        && resource.data.status == 0; // sealed
      
      // Удалять может только отправитель
      allow delete: if isAuthenticated() 
        && resource.data.senderId == request.auth.uid;
    }
    
    // ==================== Ephemeral Thoughts (Stories) ====================
    match /ephemeral_thoughts/{thoughtId} {
      // Читать могут все авторизованные (публичные stories)
      allow read: if isAuthenticated();
      
      // Создать может авторизованный пользователь
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid;
      
      // Обновлять может только автор (для просмотров и реакций)
      // или любой авторизованный для добавления в viewedBy
      allow update: if isAuthenticated() 
        && (resource.data.userId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['viewedBy', 'reactions']));
      
      // Удалять может только автор
      allow delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
    }
  }
}
